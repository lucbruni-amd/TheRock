         "If true, then runtime can skip kernel arg copy")                     \
 release(bool, GPU_STREAMOPS_CP_WAIT, false,                                   \
         "Force the stream wait memory operation to wait on CP.")              \
+release(bool, GPU_STREAMOPS_HOST_WAIT, true,                                  \
