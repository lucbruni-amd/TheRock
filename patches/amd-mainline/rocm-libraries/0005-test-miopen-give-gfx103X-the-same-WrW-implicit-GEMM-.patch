From cf2ba85b5cc5c4054973a62886c24f4326d00f36 Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Wed, 14 Oct 2026 21:09:46 -0400
Subject: [PATCH] test(miopen): give gfx103X the same WrW implicit GEMM
 tolerances as gfx908/gfx90a

ConvHipImplicitGemmV4R1WrW and ConvHipImplicitGemmV4R4WrW list gfx103X as a
supported device, but only gfx908 and gfx90a get the relaxed FP32 tolerance
(40x and 2x). On gfx103X the threshold stays at FLT_EPSILON, and both smoke
tests fail on every gfx103X runner (Linux and Windows):

  V4R1WrW: error 3.59e-06 vs threshold 1.19e-07 (30x, within 40x)
  V4R4WrW: error 1.60e-07 vs threshold 1.19e-07 (1.3x, within 2x)

Measured on gfx1036 (Windows, PAL); the same tests fail in the gfx1030
nightly CI. Apply the existing tolerances to gfx103X as well.
---
 .../test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R1WrW.cpp  | 1 +
 .../test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R4WrW.cpp  | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R1WrW.cpp b/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R1WrW.cpp
index c09261c2951..a7e1d1b67dd 100644
--- a/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R1WrW.cpp
+++ b/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R1WrW.cpp
@@ -55,6 +55,7 @@ miopen::unit_tests::UnitTestConvSolverParams GetTestParams()
     /// \todo 40.0f is too much. The solver needs to be checked.
     p.SetTolerance(Gpu::gfx908, miopenFloat, 40.0f);
     p.SetTolerance(Gpu::gfx90A, miopenFloat, 40.0f);
+    p.SetTolerance(Gpu::gfx103X, miopenFloat, 40.0f);
     return p;
 }
 
diff --git a/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R4WrW.cpp b/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R4WrW.cpp
index 6abc571a579..28e5458637b 100644
--- a/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R4WrW.cpp
+++ b/projects/miopen/test/gtest/unit_conv_solver_ConvHipImplicitGemmV4R4WrW.cpp
@@ -51,7 +51,7 @@ const auto& GetTestParams()
         Gpu supported_gpus = Gpu::gfx900 | Gpu::gfx906 | Gpu::gfx908 | Gpu::gfx90A | Gpu::gfx103X;
         auto p             = miopen::unit_tests::UnitTestConvSolverParams(supported_gpus);
         p.Tunable(5);
-        p.SetTolerance(Gpu::gfx908 | Gpu::gfx90A, miopenFloat, 2.0f);
+        p.SetTolerance(Gpu::gfx908 | Gpu::gfx90A | Gpu::gfx103X, miopenFloat, 2.0f);
         return p;
     }();
     return params;
