From c09cc4f2eea9edfb362e46aea2221366751bedf3 Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Thu, 9 Oct 2026 12:00:00 -0500
Subject: [PATCH] gfx9-win: miopen-tests-uncharacterized-arch


---
--- a/projects/miopen/test/gtest/gtest_common.cpp
+++ b/projects/miopen/test/gtest/gtest_common.cpp
@@ -98,7 +98,8 @@
         return Gpu::gfx120X;
     if(miopen::StartsWith(arch, "gfx125"))
         return Gpu::gfx125X;
-    throw std::runtime_error("unknown_gpu");
+    // An uncharacterized arch (e.g. gfx90c): device-gated tests skip instead of every SetUp throwing.
+    return Gpu::None;
 }
 
 Gpu GetDevGpuType()
--- a/projects/miopen/test/gtest/handle_test.cpp
+++ b/projects/miopen/test/gtest/handle_test.cpp
@@ -167,7 +167,8 @@
     const auto known_arch = {"gfx908",  "gfx90a",  "gfx906",  "gfx900",  "gfx942",
                              "gfx950",  "gfx803",  "gfx1030", "gfx1031", "gfx1100",
                              "gfx1101", "gfx1102", "gfx1103", "gfx1150", "gfx1151",
-                             "gfx1152", "gfx1153", "gfx1200", "gfx1201", "gfx1250"};
+                             "gfx1152", "gfx1153", "gfx1200", "gfx1201", "gfx1250",
+                             "gfx90c",  "gfx1036"};
 
     const auto this_arch = h.GetDeviceName();
 
