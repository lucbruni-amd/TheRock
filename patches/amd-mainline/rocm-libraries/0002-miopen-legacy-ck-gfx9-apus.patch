From 089c457a7917e64896fe077182db228f8418bb6a Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Fri, 9 Oct 2026 12:00:00 -0500
Subject: [PATCH 2/5] fix(miopen): map gfx9 APUs to the gfx900 path in legacy
 CK

The legacy composable_kernel config.hpp has no CK_AMD_GPU_GFX* case for
gfx902, gfx909 or gfx90c and stops with "#error No CK_AMD_GPU_GFX* macro
defined", so MIOpen's Reduce and RNN kernels fail to compile there.

These APUs have the gfx900 feature set (no dot or fmac instructions), so
define CK_AMD_GPU_GFX900 for them.

Checked on gfx90c: Reduce/RNN 8/20 -> 20/20.
---
 .../composable_kernel/include/utility/config.hpp            | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/projects/miopen/src/legacy_composable_kernel/composable_kernel/include/utility/config.hpp b/projects/miopen/src/legacy_composable_kernel/composable_kernel/include/utility/config.hpp
index 7b5ff9c5775..33dab0d15c0 100644
--- a/projects/miopen/src/legacy_composable_kernel/composable_kernel/include/utility/config.hpp
+++ b/projects/miopen/src/legacy_composable_kernel/composable_kernel/include/utility/config.hpp
@@ -4,6 +4,12 @@
 #ifndef CK_CONFIG_AMD_HPP
 #define CK_CONFIG_AMD_HPP
 
+// gfx9 APUs (gfx902, gfx909, gfx90c) have the gfx900 feature set (no dot or fmac instructions),
+// so they take the gfx900 code paths below.
+#if defined(CK_AMD_GPU_GFX902) || defined(CK_AMD_GPU_GFX909) || defined(CK_AMD_GPU_GFX90C)
+#define CK_AMD_GPU_GFX900
+#endif
+
 #ifndef MIOPEN_HIP_RUNTIME_COMPILE
 #include "hip/hip_runtime.h"
 #include "hip/hip_fp16.h"
