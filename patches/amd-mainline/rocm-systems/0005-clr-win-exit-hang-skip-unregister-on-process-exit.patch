From 109ffe43e27ff31f06f4d3da716ea5351d5b7ae0 Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Fri, 9 Oct 2026 12:00:00 -0500
Subject: [PATCH 05/15] fix(clr): do not wait for the GPU while a Windows
 process exits

During ExitProcess, Windows terminates every other thread before it runs
DLL_PROCESS_DETACH and the CRT atexit callbacks of the DLLs being unloaded.
Work in flight on ROCr's PM4-emulation queues is completed by those threads,
so __hipUnregisterFatBinary draining the streams waits forever: a process
with a HIP DLL hangs at exit if GPU work is in flight.

Detect process exit and skip the GPU work in that path; the OS reclaims
everything.

Affects the Windows ROCr PM4 path: gfx9 and RDNA2 (also on the official
nightly). Reproduced and fixed on gfx90c and gfx1036.
---
 projects/clr/hipamd/src/hip_platform.cpp | 10 ++++++++++
 projects/clr/hipamd/src/hip_runtime.cpp  | 10 ++++++++++
 2 files changed, 20 insertions(+)

diff --git a/projects/clr/hipamd/src/hip_platform.cpp b/projects/clr/hipamd/src/hip_platform.cpp
index 76e7efed86..c1c146e47a 100644
--- a/projects/clr/hipamd/src/hip_platform.cpp
+++ b/projects/clr/hipamd/src/hip_platform.cpp
@@ -331,7 +331,17 @@ void __hipRegisterTexture(
 }
 
 // ================================================================================================
+#ifdef _WIN32
+bool ihipProcessIsTerminating();
+#endif
+
 void __hipUnregisterFatBinary(void** modules) {
+#ifdef _WIN32
+  // Called from a DLL's atexit handler while the process exits: its other threads, including
+  // ROCr's queue helper threads, are already gone, so draining the streams below can never
+  // complete. The OS reclaims everything, so do no GPU work at all.
+  if (ihipProcessIsTerminating()) return;
+#endif
   auto* fat_binary_modules = reinterpret_cast<hip::FatBinaryInfo**>(modules);
   static std::once_flag unregister_device_sync;
   // If SKIP ABORT is set and GPU is in error, dont need to sync streams.
diff --git a/projects/clr/hipamd/src/hip_runtime.cpp b/projects/clr/hipamd/src/hip_runtime.cpp
index 6a37880ea3..a5341e0da2 100644
--- a/projects/clr/hipamd/src/hip_runtime.cpp
+++ b/projects/clr/hipamd/src/hip_runtime.cpp
@@ -13,6 +13,16 @@
 
 namespace hip {
 void ihipDestroyDevice();
+
+// During ExitProcess, Windows terminates every other thread before it runs DLL_PROCESS_DETACH and
+// the CRT atexit callbacks of the DLLs being unloaded. Work in flight on ROCr's PM4-emulation
+// queues is completed by those threads, so anything that waits for the GPU then waits forever.
+bool ihipProcessIsTerminating() {
+  using RtlDllShutdownInProgressFn = BOOLEAN(NTAPI*)();
+  static const auto shutdown_in_progress = reinterpret_cast<RtlDllShutdownInProgressFn>(
+      ::GetProcAddress(::GetModuleHandleW(L"ntdll.dll"), "RtlDllShutdownInProgress"));
+  return shutdown_in_progress != nullptr && shutdown_in_progress() != FALSE;
+}
 }
 
