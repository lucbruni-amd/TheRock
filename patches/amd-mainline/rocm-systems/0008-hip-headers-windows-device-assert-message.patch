From 4ea4b040427c867d5d4e526079d0a8635fc645e1 Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Thu, 9 Oct 2026 12:00:00 -0500
Subject: [PATCH] gfx9-win: hip-headers-windows-device-assert-message


---
--- a/projects/clr/hipamd/include/hip/amd_detail/hip_assert.h
+++ b/projects/clr/hipamd/include/hip/amd_detail/hip_assert.h
@@ -17,9 +17,33 @@
 // allows the function to exist as a global although its definition is
 // included in every compilation unit.
 #if defined(_WIN32) || defined(_WIN64)
+// MSVC's assert() passes the expression and the file name as wide strings. Print them like
+// __assert_fail does elsewhere; the text is ASCII in practice, so each code unit is narrowed to one
+// byte (anything else prints as '?') in a bounded local buffer.
 extern "C" __device__ __attribute__((noinline)) __attribute__((weak)) void _wassert(
     const wchar_t* _msg, const wchar_t* _file, unsigned _line) {
-  // FIXME: Need `wchar_t` support to generate assertion message.
+  constexpr int kMaxLen = 256;
+  char msg[kMaxLen];
+  char file[kMaxLen];
+  // Returns the length including the null terminator, as append_string_n() requires.
+  auto narrow = [](const wchar_t* in, char* out) {
+    int n = 0;
+    for (; in != nullptr && in[n] != 0 && n < kMaxLen - 1; ++n) {
+      out[n] = (in[n] < 0x80) ? static_cast<char>(in[n]) : '?';
+    }
+    out[n] = 0;
+    return n + 1;
+  };
+  const char fmt[] = "%s:%u: Device-side assertion `%s' failed.\n";
+  const int file_len = narrow(_file, file);
+  const int msg_len = narrow(_msg, msg);
+
+  auto desc = __ockl_fprintf_stderr_begin();
+  desc = __ockl_fprintf_append_string_n(desc, fmt, sizeof(fmt), 0);
+  desc = __ockl_fprintf_append_string_n(desc, file, file_len, 0);
+  desc = __ockl_fprintf_append_args(desc, 1, _line, 0, 0, 0, 0, 0, 0, 0);
+  __ockl_fprintf_append_string_n(desc, msg, msg_len, /* is_last = */ 1);
+
   __builtin_trap();
 }
 #else /* defined(_WIN32) || defined(_WIN64) */
