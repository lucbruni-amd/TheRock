 .../libhsakmt/src/dxg/wddm/device.cpp         | 49 +++++++++++++++++++
 .../libhsakmt/src/dxg/wddm/queue.cpp          | 21 ++++----
 3 files changed, 64 insertions(+), 10 deletions(-)

