From 2e9169945b7f58f169526d18b3545ceaae065899 Mon Sep 17 00:00:00 2001
From: Luca Bruni <luca.bruni@amd.com>
Date: Fri, 9 Oct 2026 12:00:00 -0500
Subject: [PATCH] fix(device-libs): use software dot products where the target
 has no dot instructions

The ockl dot builtins pick hardware instructions unless the ISA version is in
the SWDOT/SWFDOT/SWIDOT2 lists. gfx90c (9012) and gfx1013 (10103) have no dot
instructions but are missing from the lists, so the builtins emit opcodes the
target does not have or are deleted as invalid. Separately, 6f5e729 dropped
gfx900/902/904/909/1010 from SWFDOT, so __ockl_fdot2 regressed on them.

Add 9012 and 10103 to all three lists and restore the pre-gfx906, gfx909 and
gfx1010 cases in SWFDOT.

Checked: all 7 dot functions compiled for 33 targets; hipTestNativeHalf,
Rtc_MathFunctions_header and Rtc_fp16_header pass on gfx90c.
---
 amd/device-libs/ockl/src/dots.cl | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/amd/device-libs/ockl/src/dots.cl b/amd/device-libs/ockl/src/dots.cl
index 5a3de1d25e24..ec2ce1184d76 100644
--- a/amd/device-libs/ockl/src/dots.cl
+++ b/amd/device-libs/ockl/src/dots.cl
@@ -67,9 +67,9 @@ __attribute__((target("dot8-insts"), const)) static uint amdgcn_sudot8(bool as,
                         return __builtin_amdgcn_sudot8(true , a, true , b, c, true );
 }
 
-#define SWDOT __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 10100 || __oclc_ISA_version >= 12500
-#define SWFDOT (__oclc_ISA_version >= 10200 && __oclc_ISA_version < 10300) || __oclc_ISA_version >= 12500
-#define SWIDOT2 __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 10100 || __oclc_ISA_version >= 11000
+#define SWDOT __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 9012 || __oclc_ISA_version == 10100 || __oclc_ISA_version == 10103 || __oclc_ISA_version >= 12500
+#define SWFDOT __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 9012 || __oclc_ISA_version == 10100 || __oclc_ISA_version == 10103 || (__oclc_ISA_version >= 10200 && __oclc_ISA_version < 10300) || __oclc_ISA_version >= 12500
+#define SWIDOT2 __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 9012 || __oclc_ISA_version == 10100 || __oclc_ISA_version == 10103 || __oclc_ISA_version >= 11000
 #define SUDOT __oclc_ISA_version >= 11000
 
 #define AS_INT(X) __builtin_astype(X, int)
-- 
