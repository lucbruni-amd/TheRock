         .addImm(static_cast<unsigned>(GCNSubtarget::TrapID::LLVMAMDHSATrap))
         .addReg(SGPR01, RegState::Implicit);
-    MI.eraseFromParent();
-    return true;
+    return legalizeTrapEndpgm(Helper, MI);
   }
 
   // Pass queue pointer to trap handler as input, and insert trap instruction
@@ -7976,11 +7978,11 @@ bool AMDGPULegalizerInfo::legalizeTrapHsaQueuePtr(
       .addImm(static_cast<unsigned>(GCNSubtarget::TrapID::LLVMAMDHSATrap))
       .addReg(SGPR01, RegState::Implicit);
 
-  MI.eraseFromParent();
-  return true;
+  return legalizeTrapEndpgm(Helper, MI);
 }
 
-bool AMDGPULegalizerInfo::legalizeTrapHsa(MachineInstr &MI,
+bool AMDGPULegalizerInfo::legalizeTrapHsa(LegalizerHelper &Helper,
+                                          MachineInstr &MI,
                                           MachineRegisterInfo &MRI,
                                           MachineIRBuilder &B) const {
   // We need to simulate the 's_trap 2' instruction on targets that run in
@@ -7994,8 +7996,7 @@ bool AMDGPULegalizerInfo::legalizeTrapHsa(MachineInstr &MI,
 
   B.buildInstr(AMDGPU::S_TRAP)
       .addImm(static_cast<unsigned>(GCNSubtarget::TrapID::LLVMAMDHSATrap));
-  MI.eraseFromParent();
-  return true;
+  return legalizeTrapEndpgm(Helper, MI);
 }
 
