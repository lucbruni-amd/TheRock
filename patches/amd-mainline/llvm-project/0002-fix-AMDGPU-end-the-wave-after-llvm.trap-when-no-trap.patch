diff --git a/llvm/lib/Target/AMDGPU/SIISelLowering.cpp b/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
index 2bae332933be..553a330e43af 100644
--- a/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
+++ b/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
@@ -9256,6 +9256,11 @@ SDValue SITargetLowering::lowerXMUL_LOHI(SDValue Op, SelectionDAG &DAG) const {
   return Op;
 }
 
+// With the AMDHSA trap handler ABI, llvm.trap is s_trap 2 and the handler halts
+// the wave. If no handler is actually installed (e.g. a driver that cannot
+// install one), s_trap is a no-op and the wave would run whatever follows the
+// trap, so append the s_endpgm fallback used when there is no trap handler.
+// With a handler installed it is never reached.
 SDValue SITargetLowering::lowerTRAP(SDValue Op, SelectionDAG &DAG) const {
   if (!Subtarget->hasTrapHandler() ||
       Subtarget->getTrapHandlerAbi() != GCNSubtarget::TrapHandlerAbi::AMDHSA)
@@ -9318,7 +9323,8 @@ SDValue SITargetLowering::lowerTrapHsaQueuePtr(SDValue Op,
   uint64_t TrapID = static_cast<uint64_t>(GCNSubtarget::TrapID::LLVMAMDHSATrap);
   SDValue Ops[] = {ToReg, DAG.getTargetConstant(TrapID, SL, MVT::i16), SGPR01,
                    ToReg.getValue(1)};
-  return DAG.getNode(AMDGPUISD::TRAP, SL, MVT::Other, Ops);
+  SDValue Trap = DAG.getNode(AMDGPUISD::TRAP, SL, MVT::Other, Ops);
+  return DAG.getNode(AMDGPUISD::ENDPGM_TRAP, SL, MVT::Other, Trap);
 }
 
 SDValue SITargetLowering::lowerTrapHsa(SDValue Op, SelectionDAG &DAG) const {
@@ -9332,7 +9338,8 @@ SDValue SITargetLowering::lowerTrapHsa(SDValue Op, SelectionDAG &DAG) const {
 
   uint64_t TrapID = static_cast<uint64_t>(GCNSubtarget::TrapID::LLVMAMDHSATrap);
   SDValue Ops[] = {Chain, DAG.getTargetConstant(TrapID, SL, MVT::i16)};
-  return DAG.getNode(AMDGPUISD::TRAP, SL, MVT::Other, Ops);
+  SDValue Trap = DAG.getNode(AMDGPUISD::TRAP, SL, MVT::Other, Ops);
+  return DAG.getNode(AMDGPUISD::ENDPGM_TRAP, SL, MVT::Other, Trap);
 }
 
 SDValue SITargetLowering::lowerDEBUGTRAP(SDValue Op, SelectionDAG &DAG) const {
