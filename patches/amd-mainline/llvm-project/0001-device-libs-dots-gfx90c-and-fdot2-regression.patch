+#define SWIDOT2 __oclc_ISA_version < 9006 || __oclc_ISA_version == 9009 || __oclc_ISA_version == 9012 || __oclc_ISA_version == 10100 || __oclc_ISA_version == 10103 || __oclc_ISA_version >= 11000
 #define SUDOT __oclc_ISA_version >= 11000
 
 #define AS_INT(X) __builtin_astype(X, int)
