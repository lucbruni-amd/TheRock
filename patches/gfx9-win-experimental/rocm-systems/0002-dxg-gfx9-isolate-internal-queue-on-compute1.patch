@@ -115,6 +115,7 @@ public:
   // DXUMD_SCHEDULERIDENTIFIER_COMPUTE0 from the KMD scheduler enum (kdx_umd.h,
   // not on this include path). The PM4 path must run on COMPUTE0.
   static constexpr uint32_t kSchedulerIdCompute0 = 5;
+  static constexpr uint32_t kSchedulerIdCompute1 = 6;
 
   WDDMDevice(D3DKMT_HANDLE adapter, LUID adapter_luid, uint32_t node_id);
   ~WDDMDevice();
@@ -173,6 +174,11 @@ public:
   uint32_t GetComputeEngine() { return device_info_.compute_schedid; }
 
   uint64_t VramTotal();
+  // Engine for the next AQL compute queue. gfx9 KMDs serialise contexts that share a WDDM node,
+  // so a kernel waiting on another queue's progress (or on a runtime blit such as a code object
+  // upload) deadlocks until the watchdog fires. Spread non-HWS gfx9 queues over COMPUTE0/COMPUTE1.
+  uint32_t NextComputeEngine();
+
   hsa_status_t VramAvail(uint64_t* available_bytes);
 
   void GetClockCounters(uint64_t *gpu, uint64_t *cpu);
@@ -302,6 +308,7 @@ private:
   std::atomic<uint64_t> page_fence_value_;
 
   uint32_t cmdbuf_size_;
+  std::atomic<uint32_t> compute_queue_count_{0};
   uint32_t cmdbuf_aql_frame_size_;
   // Both narrowed by InitCmdbufInfo(): the ring so it keeps fitting in a fixed
   // byte budget as the frame size grows, the merge limit so a run of merged
diff --git a/projects/rocr-runtime/libhsakmt/src/dxg/queues.cpp b/projects/rocr-runtime/libhsakmt/src/dxg/queues.cpp
index f8fb999b8d..82453d91ef 100644
--- a/projects/rocr-runtime/libhsakmt/src/dxg/queues.cpp
+++ b/projects/rocr-runtime/libhsakmt/src/dxg/queues.cpp
@@ -114,7 +114,7 @@ HSAKMT_STATUS HSAKMTAPI hsaKmtCreateQueueV2(HSAuint32 NodeId,
   case HSA_QUEUE_COMPUTE_AQL: {
     uint64_t pkg_num = QueueSizeInBytes / 64;
     uint32_t cmdbuf_size = device_->GetCmdbufSize();
-    uint32_t queue_engine = device_->GetComputeEngine();
+    uint32_t queue_engine = device_->NextComputeEngine();
     bool use_hws = device_->IsHwsEnabled(queue_engine);
     HSAuint32 event_id = Event ? Event->EventId : 0;
     auto queue_ = new wsl::thunk::ComputeQueue(
diff --git a/projects/rocr-runtime/libhsakmt/src/dxg/wddm/device.cpp b/projects/rocr-runtime/libhsakmt/src/dxg/wddm/device.cpp
index 0c2c76605d..f5852f32fb 100644
--- a/projects/rocr-runtime/libhsakmt/src/dxg/wddm/device.cpp
+++ b/projects/rocr-runtime/libhsakmt/src/dxg/wddm/device.cpp
@@ -498,6 +498,17 @@ bool WDDMDevice::Unlock(D3DKMT_HANDLE handle) {
   return false;
 }
 
+uint32_t WDDMDevice::NextComputeEngine() {
+  uint32_t engine = GetComputeEngine();
+  // ROCR_USE_PM4=1 must stay on COMPUTE0 (see the constructor).
+  if (device_info_.major != 9 || dxg_runtime->use_pm4_ || IsHwsEnabled(engine) ||
+      EngineOrdinal(kSchedulerIdCompute1, &device_info_) < 0)
+    return engine;
+  // The first compute queue is the runtime's internal blit queue (code object uploads and other
+  // staging copies). Give it COMPUTE1 so it can run while a user kernel occupies COMPUTE0.
+  return (compute_queue_count_.fetch_add(1) == 0) ? kSchedulerIdCompute1 : engine;
+}
