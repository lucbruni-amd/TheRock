+  // EXPERIMENT (DXG_TRAP=1): ROCr binds a gfx9 handler that records traps at TMA and ends the
+  // wave. Only enable it per dispatch (TRAP_PRESENT) if the kernel driver accepted it.
+  const char* exp = getenv("DXG_TRAP");
+  if (ok && device_info_.major == 9 && exp != nullptr && exp[0] == '1' && tma != 0) {
+    trap_mailbox_ = reinterpret_cast<volatile uint32_t*>(tma);
+    trap_bound_ = true;
+  }
+  if (getenv("DXG_TRAP_DIAG") != nullptr) {
+    fprintf(stderr, "[DXG_TRAP] SetTrapHandler escape: tba=0x%llx tma=0x%llx -> %s, bound=%d\n",
+            (unsigned long long)tba, (unsigned long long)tma, ok ? "ok" : "FAILED", trap_bound_);
+  }
   return ok;
 }
 
+bool WDDMDevice::CheckTrap() {
+  if (!trap_bound_) return false;
+  uint32_t count = trap_mailbox_[0];
+  uint32_t seen = trap_seen_.load();
+  if (count == seen || !trap_seen_.compare_exchange_strong(seen, count)) return false;
+  // Record layout written by the handler: +0x40 + slot * 0x80: ttmp0-15, STATUS, TRAPSTS, HW_ID.
+  const volatile uint32_t* rec = trap_mailbox_ + (0x40 + (seen & 3) * 0x80) / 4;
+  pr_err("GPU trap: wave ended by trap handler (traps so far %u), PC 0x%04x%08x trap id %u, "
+         "STATUS 0x%08x TRAPSTS 0x%08x HW_ID 0x%08x\n",
+         count, rec[1] & 0xffff, rec[0], (rec[1] >> 16) & 0xff, rec[16], rec[17], rec[18]);
+  if (getenv("DXG_TRAP_DIAG") != nullptr) {
+    for (int i = 0; i < 16; i++) fprintf(stderr, "[DXG_TRAP]   ttmp%-2d = 0x%08x\n", i, rec[i]);
+  }
+  return true;
+}
