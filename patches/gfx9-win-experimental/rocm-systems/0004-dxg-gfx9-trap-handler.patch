+// gfx9 trap handler for the Windows dxg path (EXPERIMENT, DXG_TRAP=1). The PM4-emulated queues
+// have no consumer for the s_sendmsg interrupt the regular handlers rely on, so this handler
+// records the trap in a mailbox and ends the wave; the thunk reports it after the dispatch's fence.
+// The mailbox address is stored at handler + kDxgTrapMailboxPtrOffset. Source:
+// upstream-patches/trap-prototype/dxg_trap_gfx9.s.
+static const unsigned int kCodeTrapHandlerDxg9[] = {
+    0xbe801c00, 0x8000ff00, 0x000000fc, 0x82018001, 0xc0070080, 0x00000000,
+    0xbf8cc07f, 0xbe840081, 0xc20b0101, 0x00000000, 0xbf8cc07f, 0xbf098404,
+    0xbf850013, 0x8e048704, 0x8004c004, 0x80020402, 0x82038003, 0xc04b1b01,
+    0x00000000, 0xc04b1c01, 0x00000010, 0xc04b1d01, 0x00000020, 0xc04b1e01,
+    0x00000030, 0xb884f802, 0xb885f803, 0xb886f804, 0xbe8700ff, 0x50415254,
+    0xc04b0101, 0x00000040, 0xc0840000, 0x00000000, 0xbf8cc07f, 0xbf810000,
+};
+static constexpr size_t kDxgTrapMailboxPtrOffset = 0x100;
+static constexpr size_t kDxgTrapMailboxSize = 0x1000;
+
+static bool DxgTrapExperimentEnabled() {
+  const char* v = getenv("DXG_TRAP");
+  return v != nullptr && v[0] == '1';
+}
+
 void GpuAgent::BindTrapHandler() {
   if (supported_isas()[0]->GetMajorVersion() == 7) {
     // No trap handler support on Gfx7, soft error.
     return;
   }
 
+  if (core::Runtime::runtime_singleton_->thunkLoader()->IsDXG() && DxgTrapExperimentEnabled() &&
+      supported_isas()[0]->GetMajorVersion() == 9 && supported_isas()[0]->GetMinorVersion() == 0 &&
+      supported_isas()[0]->GetStepping() != 10) {
+    static_assert(sizeof(kCodeTrapHandlerDxg9) <= kDxgTrapMailboxPtrOffset, "handler too large");
+    trap_code_buf_size_ = 0x1000;
+    trap_code_buf_ = system_allocator()(trap_code_buf_size_, 0x1000,
+                                        core::MemoryRegion::AllocateExecutable |
+                                        core::MemoryRegion::AllocateExecutableBlitKernelObject);
+    trap_mailbox_ = system_allocator()(kDxgTrapMailboxSize, 0x1000, 0);
+    if (trap_code_buf_ == nullptr || trap_mailbox_ == nullptr) {
+      throw AMD::hsa_exception(HSA_STATUS_ERROR_OUT_OF_RESOURCES, "Trap handler allocation failed.");
+    }
+    memset(trap_code_buf_, 0, trap_code_buf_size_);
+    memcpy(trap_code_buf_, kCodeTrapHandlerDxg9, sizeof(kCodeTrapHandlerDxg9));
+    memset(trap_mailbox_, 0, kDxgTrapMailboxSize);
+    const uint64_t mailbox = reinterpret_cast<uintptr_t>(trap_mailbox_);
+    memcpy(static_cast<char*>(trap_code_buf_) + kDxgTrapMailboxPtrOffset, &mailbox,
+           sizeof(mailbox));
+    hsa_status_t err = driver().SetTrapHandler(node_id(), trap_code_buf_, trap_code_buf_size_,
+                                               trap_mailbox_, kDxgTrapMailboxSize);
+    if (getenv("DXG_TRAP_DIAG") != nullptr) {
+      fprintf(stderr, "[DXG_TRAP] ROCr bound dxg gfx9 handler: tba=%p tma=%p status=%d\n",
+              trap_code_buf_, trap_mailbox_, int(err));
+    }
+    return;
+  }
+
   // Assemble the trap handler source code.
   void* tma_addr = nullptr;
   uint64_t tma_size = 0;
